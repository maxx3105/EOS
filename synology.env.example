# EOS + Victron Cerbo GX on Synology
#
# Copy this file to "synology.env".
# For a normal first installation you only need to change the three REQUIRED values below.

# -----------------------------------------------------------------------------
# REQUIRED 1/3: Latitude of the PV site
# -----------------------------------------------------------------------------
EOS_GENERAL__LATITUDE=48.2082

# -----------------------------------------------------------------------------
# REQUIRED 2/3: Longitude of the PV site
# -----------------------------------------------------------------------------
EOS_GENERAL__LONGITUDE=16.3738

# -----------------------------------------------------------------------------
# REQUIRED 3/3: Local IP address or hostname of the Cerbo GX
# -----------------------------------------------------------------------------
EOS_ADAPTER__VICTRON__HOST=192.168.1.50

# -----------------------------------------------------------------------------
# Recommended: replace this with your own long random string
# -----------------------------------------------------------------------------
EOS_SERVER__EOSDASH_SESSKEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Ready-to-use defaults - normally no changes required
# -----------------------------------------------------------------------------
EOS_EMS__MODE=PREDICTION
EOS_EMS__INTERVAL=300
EOS_WEATHER__WEATHER_PROVIDER=OpenMeteo
EOS_PVFORECAST__PVFORECAST_PROVIDER=PVForecastPVLibVictron
EOS_PREDICTION__HOURS=48
EOS_ADAPTER__PROVIDER=["Victron"]
EOS_ADAPTER__VICTRON__PORT=502
EOS_ADAPTER__VICTRON__UNIT_ID=100
EOS_ADAPTER__VICTRON__TIMEOUT_SEC=3
EOS_ADAPTER__VICTRON__INCLUDE_AC_COUPLED_PV=true
EOS_ADAPTER__VICTRON__PV_ENERGY_KEY=victron_pv_emr
EOS_ADAPTER__VICTRON__MAX_INTEGRATION_GAP_MINUTES=15
