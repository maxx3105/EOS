# -----------------------------------------------------------------------------
# EOS + Victron Cerbo GX on Synology
# Copy this file to "synology.env" and change the values marked CHANGE ME.
# -----------------------------------------------------------------------------

# Your PV site location - CHANGE ME
EOS_GENERAL__LATITUDE=48.2082
EOS_GENERAL__LONGITUDE=16.3738

# Run forecast and data acquisition automatically every 5 minutes.
# Keep PREDICTION for the easy/safe setup. OPTIMIZATION can be enabled later.
EOS_EMS__MODE=PREDICTION
EOS_EMS__INTERVAL=300

# Weather and PV forecast providers
EOS_WEATHER__WEATHER_PROVIDER=OpenMeteo
EOS_PVFORECAST__PVFORECAST_PROVIDER=PVForecastPVLibVictron
EOS_PREDICTION__HOURS=48

# Enable direct, read-only Victron Cerbo GX access
EOS_ADAPTER__PROVIDER=["Victron"]

# Cerbo GX IP address - CHANGE ME
EOS_ADAPTER__VICTRON__HOST=192.168.1.50
EOS_ADAPTER__VICTRON__PORT=502
EOS_ADAPTER__VICTRON__UNIT_ID=100
EOS_ADAPTER__VICTRON__TIMEOUT_SEC=3

# Total PV = AC-coupled PV + DC-coupled PV reported by the GX system service.
# Set to false if you intentionally only want DC-coupled PV register 850.
EOS_ADAPTER__VICTRON__INCLUDE_AC_COUPLED_PV=true

# EOS creates this cumulative kWh measurement from live Victron PV power.
# It is automatically registered for the measured-PV forecast correction.
EOS_ADAPTER__VICTRON__PV_ENERGY_KEY=victron_pv_emr
EOS_ADAPTER__VICTRON__MAX_INTEGRATION_GAP_MINUTES=15

# Optional: set a private EOSdash session key instead of the Dockerfile default.
EOS_SERVER__EOSDASH_SESSKEY=change-me-to-a-long-random-string
